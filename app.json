{
  "expo": {
    "name": "Prrt!",
    "slug": "prrtapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./asset/images/Prrt_icon.png",
    "scheme": "prrtapp",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#ebb89b",
    "newArchEnabled": true,
    "splash": {
      "image": "./Assets/Images/Prrt.png",
      "resizeMode": "contain",
      "backgroundColor": "#ebb89b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prrt.app",
      "buildNumber": "8",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "CFBundleDisplayName": "Prrt!",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSContactsUsageDescription": "This app uploads phone numbers from your contacts to Prrt!'s secure servers to automatically find your friends. This data is not shared with third parties.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photos so you can choose a profile picture.",
        "NSPhotoLibraryAddUsageDescription": "This app needs access to your photos so you can choose a profile picture.",
        "NSCameraUsageDescription": "This app needs access to your camera so you can take a profile picture."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./asset/images/Prrt_icon.png",
        "backgroundColor": "#ebb89b"
      },
      "package": "com.fuzztrack.proutapp",
      "versionCode": 6,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "newArchEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./withIOSPrrtSounds",
      "./withAndroidNotificationMetadata",
      "./withAndroidProutMessaging",
      "./withAndroidAppName",
      "./withIOSAppName",
      "./withIOSContactsLocalization",
      "./withVolumeManager",
      "./withSoundSettings",
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./Assets/Images/Prrt.png",
          "resizeMode": "contain",
          "backgroundColor": "#ebb89b"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./asset/images/Prrt_icon.png",
          "color": "#ffffff",
          "sounds": [
            "./assets/sounds/bzzz1.wav",
            "./assets/sounds/bzzz2.wav",
            "./assets/sounds/bzzz3.wav",
            "./assets/sounds/bzzz4.wav",
            "./assets/sounds/bzzz5.wav",
            "./assets/sounds/trrl1.wav",
            "./assets/sounds/trrl2.wav",
            "./assets/sounds/trrl3.wav",
            "./assets/sounds/trrl4.wav",
            "./assets/sounds/trrl5.wav"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "This app uploads phone numbers from your contacts to Prrt!'s secure servers to automatically find your friends. This data is not shared with third parties."
        }
      ],
      "expo-localization",
      "expo-asset",
      "./withRemoveLocationPermission",
      "expo-font"
    ],
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "jsEngine": "hermes",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bdb304d6-9f2e-4af9-82ea-4532522a031f"
      }
    },
    "owner": "fuzztrack"
  }
}
