{
  "expo": {
    "name": "Prout",
    "slug": "ProutApp",
    "version": "1.1.3",
    "orientation": "portrait",
    "icon": "./asset/images/Prrt_icon.png",
    "scheme": "proutapp",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#ebb89b",
    "newArchEnabled": false,
    "splash": {
      "image": "./Assets/Images/Prrt.png",
      "resizeMode": "contain",
      "backgroundColor": "#ebb89b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fuzztrack.proutapp",
      "buildNumber": "9",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "CFBundleDisplayName": "Prout",
        "UIBackgroundModes": ["remote-notification"],
        "ITSAppUsesNonExemptEncryption": false,
        "NSContactsUsageDescription": "Cette app envoie les numéros de vos contacts vers les serveurs sécurisés de Prrt! pour retrouver automatiquement vos amis. Ces données ne sont pas partagées avec des tiers.",
        "NSPhotoLibraryUsageDescription": "Cette application a besoin d'accéder à vos photos pour vous permettre de choisir une photo de profil.",
        "NSPhotoLibraryAddUsageDescription": "Cette application a besoin d'accéder à vos photos pour vous permettre de choisir une photo de profil.",
        "NSCameraUsageDescription": "Cette application a besoin d'accéder à votre caméra pour vous permettre de prendre une photo de profil."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./asset/images/Prrt_icon.png",
        "backgroundColor": "#ebb89b"
      },
      "package": "com.fuzztrack.proutapp",
      "versionCode": 7,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA"
      ],
      "newArchEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidNotificationMetadata",
      "./plugins/withAndroidProutMessaging",
      "./plugins/withAndroidAppName",
      "./plugins/withIOSAppName",
      "./plugins/withIOSContactsLocalization",
      "./plugins/withVolumeManager",
      "./plugins/withSoundSettings",
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      ["expo-splash-screen", { "image": "./Assets/Images/Prrt.png", "resizeMode": "contain", "backgroundColor": "#ebb89b" }],
      ["expo-notifications", { "icon": "./asset/images/Prrt_icon.png", "color": "#ffffff", "sounds": ["./assets/sounds/bzzz1.wav", "./assets/sounds/bzzz2.wav", "./assets/sounds/bzzz3.wav", "./assets/sounds/bzzz4.wav", "./assets/sounds/bzzz5.wav", "./assets/sounds/trrl1.wav", "./assets/sounds/trrl2.wav", "./assets/sounds/trrl3.wav", "./assets/sounds/trrl4.wav", "./assets/sounds/trrl5.wav"] }],
      ["expo-build-properties", { "ios": { "useFrameworks": "static" } }],
      ["expo-av", { "microphonePermission": false }],
      ["expo-contacts", { "contactsPermission": "Cette app envoie les numéros de vos contacts vers les serveurs sécurisés de Prrt! pour retrouver automatiquement vos amis. Ces données ne sont pas partagées avec des tiers." }],
      "expo-localization",
      "expo-asset",
      "./plugins/withRemoveLocationPermission"
    ],
    "assetBundlePatterns": ["assets/**/*"],
    "experiments": { "typedRoutes": true, "reactCompiler": true },
    "jsEngine": "hermes",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f2545544-14d4-4739-96a1-1fb75515e1e9"
      }
    }
  }
}
